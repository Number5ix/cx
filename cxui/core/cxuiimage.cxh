#include <cxui/cxui_shared.h>

/// @addtogroup cxui_image
/// @{

/// Pixels to draw on a canvas, or a part of another image
[methodprefix cxuiImageObj] class CxUiImage {
    // The image holding the pixels, for a part of one; NULL for an image of its own
    object[CxUiImage] _root;
    // This image's area within the root, or all of it
    CxUiRect _rect;
    // Root only: premultiplied B, G, R, A bytes, rows of _rect.w pixels
    [noinit] void* _pixels;
    // Root only: one engine's copy, made when first drawn
    [noinit] void* _cacheOps;
    [noinit] void* _cache;

    destroy();
}

/// A mouse cursor made from an image, for cxuiCanvasSetCursorImage()
[methodprefix cxuiCursor] class CxUiCursor {
    object[CxUiImage] _image;
    // The point that clicks, in the image's pixels
    CxUiPoint _hot;

    /// Creates a cursor from an image
    ///
    /// The image is in physical pixels, as the cursor is shown, so make a larger one for a
    /// display with a larger scale.
    ///
    /// @param img The image, which the cursor holds; it can be a part of another
    /// @param hotX The point that clicks: pixels from the image's left edge
    /// @param hotY Pixels from its top edge
    /// @return The cursor; release it with objRelease()
    factory create([in] CxUiImage* img, int32 hotX, int32 hotY);
}

/// @}
