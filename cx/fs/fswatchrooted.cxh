#include <cx/fs/fswatchobj.cxh>

// A watch that speaks paths relative to a root, wrapping another watch that speaks full paths.
// Adding "a/b" adds root/a/b to the inner watch, and an event for root/a/b is reported as "a/b".
// VFS providers use it to hand the VFS a watch in mount-relative paths.
class FSWatchRooted extends FSWatch {
    object[FSWatch] inner;   // set by the creator, with a closure from _fsWatchRootedInnerCls()
    string root;
    bool casei;              // compare the root case-insensitively

    factory create(strref root, bool casei, closure cls);
    destroy();
}
