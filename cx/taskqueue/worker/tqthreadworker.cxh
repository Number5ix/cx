#include "tqworker.cxh"
#include <cx/thread.h>

class TQThreadWorker extends TQWorker {
    object[Thread] thr;      // worker thread
    // This worker's currently running task, or NULL.
    atomic[ptr] curtask;
    // Keeps the task in curtask alive while the monitor accesses it.
    Mutex monitorlock;
    TQUICallback ui;
    int32 num;              // worker number
    bool shutdown;

    factory create(int32 num);
    bool startThread([in] TaskQueue *tq);
}
