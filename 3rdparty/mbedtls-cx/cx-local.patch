+/* See the MUTEX_INIT paragraph below for why this exists. */
+static LazyInitState threading_platform_state_cx;
+static void threading_platform_init_cx(void *unused)
+{
+    Futex scratch;
+    (void) unused;
+    /* Called purely for the side effect: futexInit() is what performs the
+     * process-wide platform setup. The futex itself is discarded. */
+    futexInit(&scratch, 0);
+}
+
+static int threading_mutex_init_cx(mbedtls_platform_mutex_t *mutex)
+{
+    mutexInit(mutex);
+    return 0;
+}
+
+static void threading_mutex_destroy_cx(mbedtls_platform_mutex_t *mutex)
+{
+    mutexDestroy(mutex);
+}
+
+static int threading_mutex_lock_cx(mbedtls_platform_mutex_t *mutex)
+{
+    lazyInit(&threading_platform_state_cx, threading_platform_init_cx, NULL);
+    mutexAcquire(mutex);
+    return 0;
+}
+
+static int threading_mutex_unlock_cx(mbedtls_platform_mutex_t *mutex)
+{
+    return mutexRelease(mutex) ? 0 : MBEDTLS_ERR_THREADING_USAGE_ERROR;
+}
