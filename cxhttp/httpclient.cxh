#include <cx/net/net_shared.h>
#include <cx/thread/mutex.h>
#include <cxhttp/http_shared.h>
#include <cxhttp/httpconn.cxh>
#include <cxhttp/httpcookie.cxh>
#include <cxhttp/httprequest.cxh>
#include <cxtls.h>

/// @addtogroup http_client
/// @{
/// The high-level client: a URL goes in and a response comes back.
///
/// A client owns everything a single request should not have to think about -- which queue to run
/// on, how to negotiate TLS, where cookies live, which connections are worth keeping, and how long
/// to wait. Requests are cheap objects created against it; the client is created once and shared.
///
/// @code
///   NetQueueConfig conf;
///   netqueuePresetClient(&conf);
///   NetQueue* q      = netqueueCreate(&conf);
///   HttpClient* http = httpclientCreate(q);
///
///   HttpRequest* req = httprequestCreate(HTTP_Get, _SL("https://example.com/api/thing"));
///   httprequestSetHeader(req, _SL("Accept"), _SL("application/json"));
///
///   static const HttpHandlers handlers = { .complete = onDone, .error = onFailed };
///   httpclientSend(http, req, &handlers, ctx);
///
///   while (!done)
///       netqueueTick(q, timeMS(100));
/// @endcode
///
/// A client must outlive every request it is running. That is the one lifetime rule here, and it
/// falls out of what a client is: requests borrow its queue, its TLS configuration and its
/// connection pool for as long as they are in flight.
///
/// Configure a client before sending through it. Requests may then be sent from any thread and the
/// pool is safe against them, but reconfiguring one while requests are in flight -- changing the
/// TLS configuration, the jar, or the timeouts -- is not supported.

/// @brief Connection pooling, TLS, cookies, redirects and timeouts for a set of requests
class HttpClient
{
    /// @brief Queue every connection runs on
    object[NetQueue] queue;

    /// @brief TLS configuration for https, created on demand if the application does not supply one
    ///
    /// The default is a client configuration with the system trust store and `http/1.1` offered as
    /// the only ALPN protocol. An application that needs pinning, a private CA, or client
    /// certificates builds its own and calls setTlsConfig().
    object[TlsConfig] tls;

    /// @brief Cookie jar, or NULL to neither send nor store cookies
    object[HttpCookieJar] jar;

    /// @brief Headers added to every request that does not set them itself
    ///
    /// `User-Agent` is here by default. Anything a request sets explicitly wins, so a default is a
    /// default rather than an override.
    HttpHeaders defaultHeaders;

    /// @brief How many redirects to follow before giving up; 0 makes every 3xx the final response
    uint32 maxRedirects;

    /// @brief How long a response may take before the request fails, in microseconds (0 = no limit)
    ///
    /// Measured from the moment the request is written to the moment the response completes, not
    /// between packets.
    int64 responseTimeout;

    /// @brief How long an unused pooled connection is kept, in microseconds (0 = do not pool)
    int64 idleTimeout;

    /// @brief Which protocols requests through this client may use
    ///
    /// HTTPV_Default, which sends HTTP/1.1 unless an origin is already known to speak HTTP/3.
    /// Set it with httpclientSetVersions().
    flags_t versions;

    /// @brief Idle HTTP/1.1 connections available for reuse
    ///
    /// Parallel to poolKeys. An entry here is taken *exclusively*: a request removes it for the
    /// duration and _recycle() puts it back.
    [noinit] sa_HttpConn pool;

    /// @brief Origin each pooled connection belongs to, as `scheme://host:port`
    [noinit] sa_string poolKeys;

    // Live HTTP/3 connections, and the origin each belongs to. Kept apart from the HTTP/1.1 pool
    // because the two are used differently rather than merely holding different types: an HTTP/3
    // entry is *borrowed*. It stays here, hands out a reference, and serves as many requests at
    // once as the peer's stream limit allows, which is what makes ten concurrent requests to one
    // origin cost one connection instead of ten.
    //
    // Held as ObjInst, which is what keeps the HTTP/3 connection class out of the public headers.
    [noinit] sa_object h3pool;
    [noinit] sa_string h3poolKeys;

    // What this client has learned about each origin it has spoken to: whether HTTP/3 worked
    // there, or failed outright, until when, and on which port if not the origin's own. This is
    // what makes HTTPV_Any cost one extra connection attempt per origin rather than one per
    // request, and what lets HTTPV_Default reach HTTP/3 at all -- an origin becomes known either
    // by having been reached that way before or by an Alt-Svc header on a response.
    //
    // Four parallel arrays rather than one of structs, so the element types stay ones cx's own
    // stype machinery copies and releases. All four are always the same length; nothing outside
    // httpaltsvc.c touches them.
    [noinit] sa_string originKeys;
    [noinit] sa_uint32 originFlags;
    [noinit] sa_int64 originExpires;
    [noinit] sa_uint16 originAltPort;

    // Origins with a QUIC dial in flight, and the requests parked on one. Without this, ten
    // concurrent requests to a new origin would start ten dials and end with ten connections --
    // harmless under HTTP/1.1, where each carries one request anyway, and wasteful under HTTP/3,
    // where one connection should carry all ten.
    [noinit] sa_string h3Dialing;
    [noinit] sa_HttpRequest h3Waiters;
    [noinit] sa_string h3WaiterKeys;

    /// @brief Guards the pool and the lazily-created TLS configuration
    Mutex lock;

    /// Create a client
    ///
    /// @param q Queue to run connections on; a reference is held
    /// @return The new client, or NULL if the queue is unusable
    [canfail] factory create([in] NetQueue *q);
    init();
    destroy();

    /// Supply the TLS configuration https requests use
    ///
    /// Replaces the default. `http/1.1` is added to the configuration's ALPN list if it is not
    /// already there.
    ///
    /// @param cfg Configuration to use; a reference is held. NULL restores the default.
    void setTlsConfig([in] [opt] TlsConfig *cfg);

    /// Supply the cookie jar
    ///
    /// @param jar Jar to send from and store into; a reference is held. NULL disables cookies.
    void setCookieJar([in] [opt] HttpCookieJar *jar);

    /// Set a default request header
    ///
    /// @param name Field name
    /// @param value Field value, or empty to remove the default
    /// @return true on success
    bool setHeader(strref name, strref value);

    /// Send a request
    ///
    /// Returns as soon as the exchange has started. The outcome arrives on `handlers`, on a
    /// netqueue worker, some time later -- so the request must remain valid until then, which it
    /// does: the client holds a reference for the duration.
    ///
    /// @param req Request to send; a reference is held until it completes
    /// @param handlers Callbacks for the response. Not copied -- must outlive the request, so it is
    ///                 usually `static const`
    /// @param ctx Context passed to the handlers on HttpEvent.ctx
    /// @return true if the exchange started; false means it never will, and no handler runs
    bool send([in] HttpRequest *req, [in] [opt] const HttpHandlers *handlers, [in] [opt] void *ctx);

    /// Choose which protocol versions this client may use
    ///
    /// HTTP/3 is never reached by accident: a client that has always spoken HTTP/1.1 keeps doing
    /// so until this is called, because starting to send UDP is a change a firewall or a network
    /// policy may have opinions about.
    ///
    /// @param v What to allow, and how to choose
    /// @return true if the policy was accepted; false means this build has no HTTP/3 in it, and
    ///         the client is unchanged
    ///
    /// Example:
    /// @code
    ///   httpclientSetVersions(http, HTTPV_Any);   // race QUIC and TCP, remember which won
    /// @endcode
    bool setVersions(HttpVersionPolicy v);

    /// Close and discard every pooled idle connection
    ///
    /// Requests in flight are unaffected. Worth calling when an application knows it is done
    /// talking to a host for a while, rather than waiting out the idle timeout.
    void closeIdle();

    // -----------------------------------------------------------------------------------------
    // PRIVATE IMPLEMENTATION DETAILS
    // -----------------------------------------------------------------------------------------

    // Begin (or resume, after a redirect) the exchange for a request against its current URL.
    // Either checks a pooled connection out or dials a new one.
    [extern] unbound bool _start([in] HttpRequest *req);

    // End an exchange: settle the connection, drop the client's reference, and deliver the terminal
    // event to the application's handlers.
    [extern] unbound void _finish([in] HttpRequest *req, HttpError err);

    // Hand a connection back after a response. Pooled if it is reusable and pooling is on, closed
    // otherwise. Always drops the request's reference to it.
    [extern] unbound void _recycle([in] HttpRequest *req, bool reusable);
}

/// @}
